// 理想的なスキーマ設計提案
// 主要改善点：
// 1. AnswerSheetとMasterImageの直接関連付け
// 2. 統一的なバージョン管理システム
// 3. 採点進捗計算の簡素化
// 4. パフォーマンス最適化
// 5. データ整合性の強化

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ユーザー・認証関連
// =============================================================================

model User {
  id               String              @id @default(uuid())
  username         String              @unique
  passwordHash     String?
  name             String
  role             String              @default("teacher")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  version          Int                 @default(1) // 統一的なバージョン管理
  
  // Relations
  assignedProjects GradingAssignment[]
  createdProjects  Project[]           @relation("UserProjects")
  examSessions     ProjectSession[]
  questionScores   QuestionScore[]
  scoreRecords     ScoreRecord[]
  teacherClasses   TeacherClass[]
  locks            Lock[]
  
  @@map("users")
}

// =============================================================================
// 学級・生徒管理
// =============================================================================

model Class {
  id            String                   @id @default(uuid())
  name          String                   @unique
  classCode     String?
  grade         Int?
  description   String?
  isVisible     Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  version       Int                      @default(1)
  
  // Relations
  memberships   StudentClassMembership[]
  teachers      TeacherClass[]
  
  @@map("classes")
}

model Student {
  id              String                   @id @default(uuid())
  studentId       String                   @unique
  lastName        String
  firstName       String
  lastNameKana    String
  firstNameKana   String
  enrollmentYear  Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  version         Int                      @default(1)
  
  // Relations
  answerSheets    AnswerSheet[]
  projectStudents ProjectStudent[]
  scoreRecords    ScoreRecord[]
  memberships     StudentClassMembership[]
  
  @@map("students")
}

model StudentClassMembership {
  id               String    @id @default(uuid())
  studentId        String
  classId          String
  startDate        DateTime  @default(now())
  endDate          DateTime?
  attendanceNumber Int?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Int       @default(1)
  
  // Relations
  class            Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, classId, startDate])
  @@index([studentId])
  @@index([classId])
  @@index([startDate, endDate])
  @@index([classId, attendanceNumber])
  @@map("student_class_memberships")
}

// 改善点：ClassTeachersテーブルの命名とフィールドの明確化
model TeacherClass {
  id        String   @id @default(uuid())
  teacherId String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  
  // Relations
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  @@unique([teacherId, classId])
  @@index([teacherId])
  @@index([classId])
  @@map("teacher_classes")
}

// =============================================================================
// プロジェクト・画像管理
// =============================================================================

model Project {
  id                 String              @id @default(uuid())
  examName           String
  examDate           DateTime?
  subject            String?
  description        String?
  userId             String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  version            Int                 @default(1)
  
  // Relations
  masterImages       MasterImage[]
  answerSheets       AnswerSheet[]
  layoutRegions      LayoutRegion[]
  gradingAssignments GradingAssignment[]
  user               User                @relation("UserProjects", fields: [userId], references: [id])
  projectSessions    ProjectSession[]
  projectStudents    ProjectStudent[]
  questionGroups     QuestionGroup[]
  scoreRecords       ScoreRecord[]
  
  @@index([userId])
  @@index([examDate])
  @@map("projects")
}

model MasterImage {
  id            String         @id @default(uuid())
  projectId     String
  path          String
  pageNumber    Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  version       Int            @default(1)
  
  // Relations
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  layoutRegions LayoutRegion[]
  answerSheets  AnswerSheet[]  // 新規：直接関連付け
  
  @@unique([projectId, pageNumber])
  @@index([projectId])
  @@index([projectId, pageNumber])
  @@map("master_images")
}

model ProjectStudent {
  id          String   @id @default(uuid())
  projectId   String
  studentId   String
  status      String   @default("PARTICIPATING")
  customOrder Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  
  // Relations
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@index([projectId, customOrder])
  @@map("project_students")
}

model GradingAssignment {
  projectId  String
  userId     String
  assignedAt DateTime @default(now())
  version    Int      @default(1)
  
  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@id([projectId, userId])
  @@index([userId])
  @@map("grading_assignments")
}

// =============================================================================
// レイアウト・採点領域
// =============================================================================

model LayoutRegion {
  id                          String                       @id @default(uuid())
  projectId                   String
  masterImageId               String
  label                       String
  type                        String
  x                           Float
  y                           Float
  width                       Float
  height                      Float
  points                      Int?
  orderIndex                  Int?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  version                     Int                          @default(1)
  
  // Relations
  project                     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  masterImage                 MasterImage                  @relation(fields: [masterImageId], references: [id], onDelete: Cascade)
  questionScores              QuestionScore[]
  questionSubtotalAssignments QuestionSubtotalAssignment[]
  subtotalDefinitions         SubtotalDefinition[]
  
  @@index([projectId])
  @@index([masterImageId])
  @@index([projectId, orderIndex])
  @@index([masterImageId, orderIndex])
  @@map("layout_regions")
}

// =============================================================================
// 問題グループ・小計管理（責務明確化）
// =============================================================================

model QuestionGroup {
  id        String              @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  version   Int                 @default(1)
  
  // Relations
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     QuestionGroupItem[]
  
  @@unique([projectId, name])
  @@index([projectId])
  @@map("question_groups")
}

model QuestionGroupItem {
  id                  String                       @id @default(uuid())
  name                String
  questionGroupId     String
  orderIndex          Int                          @default(0) // 統一的な命名
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  version             Int                          @default(1)
  
  // Relations
  questionGroup       QuestionGroup                @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)
  questionAssignments QuestionSubtotalAssignment[]
  subtotalDefinitions SubtotalDefinition[]
  
  @@unique([questionGroupId, name])
  @@index([questionGroupId])
  @@index([questionGroupId, orderIndex])
  @@map("question_group_items")
}

// 改善点：責務の明確化
model SubtotalDefinition {
  id                  String            @id @default(uuid())
  layoutRegionId      String
  questionGroupItemId String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  version             Int               @default(1)
  
  // Relations
  layoutRegion        LayoutRegion      @relation(fields: [layoutRegionId], references: [id], onDelete: Cascade)
  questionGroupItem   QuestionGroupItem @relation(fields: [questionGroupItemId], references: [id], onDelete: Cascade)
  
  @@unique([layoutRegionId, questionGroupItemId])
  @@index([layoutRegionId])
  @@index([questionGroupItemId])
  @@map("subtotal_definitions")
}

model QuestionSubtotalAssignment {
  id                     String            @id @default(uuid())
  questionLayoutRegionId String
  questionGroupItemId    String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  version                Int               @default(1)
  
  // Relations
  questionLayoutRegion   LayoutRegion      @relation(fields: [questionLayoutRegionId], references: [id], onDelete: Cascade)
  questionGroupItem      QuestionGroupItem @relation(fields: [questionGroupItemId], references: [id], onDelete: Cascade)
  
  @@unique([questionLayoutRegionId, questionGroupItemId])
  @@index([questionLayoutRegionId])
  @@index([questionGroupItemId])
  @@map("question_subtotal_assignments")
}

// =============================================================================
// 答案・採点関連（重要な改善）
// =============================================================================

model AnswerSheet {
  id                 String          @id @default(uuid())
  projectId          String
  studentId          String?
  masterImageId      String          // 新規：直接関連付け
  pageNumber         Int             // 保持：互換性のため
  originalImagePath  String
  processedImagePath String?
  scoredPdfPath      String?
  isScored           Boolean         @default(false)
  totalScore         Float?
  isAbsent           Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  version            Int             @default(1)
  
  // Relations
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student            Student?        @relation(fields: [studentId], references: [id])
  masterImage        MasterImage     @relation(fields: [masterImageId], references: [id], onDelete: Cascade)
  questionScores     QuestionScore[]
  
  @@unique([projectId, studentId, pageNumber])
  @@unique([projectId, studentId, masterImageId]) // 新規：直接関連付け用
  @@index([projectId])
  @@index([studentId])
  @@index([masterImageId])
  @@index([projectId, isScored])
  @@index([projectId, isAbsent])
  @@map("answer_sheets")
}

model QuestionScore {
  id             String       @id @default(uuid())
  answerSheetId  String
  layoutRegionId String
  partialScore   Decimal?
  comment        String?
  scoredByUserId String
  status         String       @default("proposed")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  version        Int          @default(1) // 統一的なバージョン管理
  
  // Relations
  answerSheet    AnswerSheet  @relation(fields: [answerSheetId], references: [id], onDelete: Cascade)
  layoutRegion   LayoutRegion @relation(fields: [layoutRegionId], references: [id], onDelete: Cascade)
  scoredByUser   User         @relation(fields: [scoredByUserId], references: [id])
  
  @@unique([answerSheetId, layoutRegionId, scoredByUserId])
  @@index([answerSheetId])
  @@index([layoutRegionId])
  @@index([scoredByUserId])
  @@index([answerSheetId, layoutRegionId, status])
  @@index([status])
  @@map("question_scores")
}

// 改善点：採点進捗計算の簡素化
model ScoreRecord {
  id                String   @id @default(uuid())
  studentId         String
  projectId         String
  totalScore        Float
  excelOutputPath   String?
  pdfOutputPath     String?
  finalizedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)
  
  // Relations
  student           Student  @relation(fields: [studentId], references: [id])
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  finalizedByUser   User?    @relation(fields: [finalizedByUserId], references: [id])
  
  @@unique([studentId, projectId])
  @@index([projectId])
  @@index([studentId])
  @@index([finalizedByUserId])
  @@map("score_records")
}

// =============================================================================
// セッション・ロック管理
// =============================================================================

model ProjectSession {
  id                String    @id @default(uuid())
  projectId         String
  userId            String
  machineIdentifier String?
  sessionStartedAt  DateTime  @default(now())
  sessionEndedAt    DateTime?
  version           Int       @default(1)
  
  // Relations
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id])
  
  @@index([projectId])
  @@index([userId])
  @@index([projectId, userId])
  @@map("project_sessions")
}

model Lock {
  id               String    @id @default(uuid())
  lockedResourceId String    @unique
  resourceType     String
  lockedByUserId   String
  lockedAt         DateTime  @default(now())
  expiresAt        DateTime?
  version          Int       @default(1)
  
  // Relations
  lockedByUser     User      @relation(fields: [lockedByUserId], references: [id])
  
  @@index([lockedResourceId, resourceType])
  @@index([lockedByUserId])
  @@index([expiresAt])
  @@map("locks")
}