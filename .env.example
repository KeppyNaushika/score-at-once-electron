# Score at Once データベース設定
DATABASE_URL="file:./data/database.db"

# Discord Webhook URL (Optional)
# Discord サーバーのチャンネル設定からWebhook URLを取得して設定してください
# 設定しない場合はDiscord通知がスキップされます
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# 例:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/abcdef1234567890abcdef1234567890abcdef12
