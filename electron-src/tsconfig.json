{
  "compilerOptions": {
    "allowJs": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    // 型を調べるだけ。main/ を作るのは esbuild（scripts/buildMain.js）で、ここが
    // 出力すると束ねた index.js を `@/…` の別名が残ったままの出力で上書きし、
    // そのまま配布物を作ると起動しなくなる（2026-10-04 に再現）
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "rootDir": "..",
    "paths": {
      "@/*": ["../src/*"],
      "@/electron-src/*": ["../electron-src/*"],
      "@prisma/client": ["../generated/prisma/client"]
    }
  },
  "exclude": ["node_modules", "../node_modules"],
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "../src/types/**/*.ts"]
}
