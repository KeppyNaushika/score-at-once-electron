generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  name           String
  role           String          @default("teacher")
  passcode       String?
  passcodeType   String?         @default("none")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  questionScores QuestionScore[]
  userProjects   UserProject[]   // Many-to-many relation
}

model Class {
  id          String                   @id @default(uuid())
  name        String                   @unique
  classCode   String?
  grade       Int?
  description String?
  isVisible   Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships StudentClassMembership[]

  @@map("classes")
}

model Student {
  id              String                   @id @default(uuid())
  studentId       String                   @unique
  lastName        String
  firstName       String
  lastNameKana    String
  firstNameKana   String
  enrollmentYear  Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  projectStudents ProjectStudent[]
  memberships     StudentClassMembership[]
  pageImages      PageImage[]             // Images associated with this student
  questionScores  QuestionScore[]         // Scores for this student
}

model StudentClassMembership {
  id               String    @id @default(uuid())
  studentId        String
  classId          String
  attendanceNumber Int?
  startDate        DateTime  @default(now())
  endDate          DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class            Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, startDate])
  @@index([studentId])
  @@index([classId])
  @@index([startDate])
  @@index([endDate])
}

model Project {
  id                    String                 @id @default(uuid())
  examName              String
  examDate              DateTime?
  subject               String?
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  projectStudents       ProjectStudent[]
  projectPages          ProjectPage[]         // Pages in this project
  userProjects          UserProject[]         // Many-to-many relation
  projectSubtotalGroups ProjectSubtotalGroup[] // Many-to-many relation
}

model ProjectStudent {
  id          String   @id @default(uuid())
  projectId   String
  studentId   String
  status      String   @default("PARTICIPATING")
  customOrder Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@index([projectId, customOrder])
}

// New: Central page management
model ProjectPage {
  id          String       @id @default(uuid())
  projectId   String
  pageNumber  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cropRegions CropRegion[] // Crop regions on this page
  pageImages  PageImage[]  // Images for this page

  @@unique([projectId, pageNumber])
  @@index([projectId])
}

// New: Unified image management (master and answer images)
model PageImage {
  id            String      @id @default(uuid())
  projectPageId String
  studentId     String?     // NULL for master images, student ID for answer images
  imagePath     String
  imageType     String      // 'MASTER' or 'ANSWER'
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  projectPage   ProjectPage @relation(fields: [projectPageId], references: [id], onDelete: Cascade)
  student       Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([projectPageId])
  @@index([studentId])
}

// Optimized CropRegion (removed redundant projectId)
model CropRegion {
  id             String          @id @default(uuid())
  projectPageId  String          // Only reference to ProjectPage
  label          String
  type           String
  x              Float
  y              Float
  width          Float
  height         Float
  points         Int?
  orderIndex     Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projectPage    ProjectPage     @relation(fields: [projectPageId], references: [id], onDelete: Cascade)
  questionScores QuestionScore[] // Scores for this crop region
  cropSubtotals  CropSubtotal[]  // Subtotal assignments

  @@index([projectPageId])
}

model SubtotalGroup {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  subtotals             Subtotal[]             // Items in this group
  projectSubtotalGroups ProjectSubtotalGroup[] // Many-to-many relation
}

model Subtotal {
  id              String         @id @default(uuid())
  name            String
  subtotalGroupId String
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subtotalGroup   SubtotalGroup  @relation(fields: [subtotalGroupId], references: [id], onDelete: Cascade)
  cropSubtotals   CropSubtotal[] // Crop region assignments

  @@unique([subtotalGroupId, name])
  @@index([subtotalGroupId])
  @@index([subtotalGroupId, order])
}

// Unified table from SubtotalDefinition and QuestionSubtotalAssignment
model CropSubtotal {
  id             String     @id @default(uuid())
  cropRegionId   String
  subtotalId     String
  assignmentType String     // 'SUBTOTAL_DEFINITION' or 'QUESTION_ASSIGNMENT'
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  subtotal       Subtotal   @relation(fields: [subtotalId], references: [id], onDelete: Cascade)
  cropRegion     CropRegion @relation(fields: [cropRegionId], references: [id], onDelete: Cascade)

  @@unique([cropRegionId, subtotalId, assignmentType])
  @@index([cropRegionId])
  @@index([subtotalId])
}

// Many-to-many User-Project relation
model UserProject {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      String   @default("GRADER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// Many-to-many Project-SubtotalGroup relation
model ProjectSubtotalGroup {
  id              String        @id @default(uuid())
  projectId       String
  subtotalGroupId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtotalGroup   SubtotalGroup @relation(fields: [subtotalGroupId], references: [id], onDelete: Cascade)

  @@unique([projectId, subtotalGroupId])
  @@index([projectId])
  @@index([subtotalGroupId])
}

// Simplified and optimized QuestionScore
model QuestionScore {
  id             String     @id @default(uuid())
  cropRegionId   String
  studentId      String?    // Student being scored (nullable for master templates)
  partialScore   Decimal?   // Actual score value (NULL = unscored)
  status         String     @default("unscored") // unscored, correct, incorrect, partial, no_answer
  scoredByUserId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  cropRegion     CropRegion @relation(fields: [cropRegionId], references: [id], onDelete: Cascade)
  student        Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scoredByUser   User?      @relation(fields: [scoredByUserId], references: [id])

  @@unique([cropRegionId, studentId, scoredByUserId])
  @@index([cropRegionId])
  @@index([studentId])
  @@index([scoredByUserId])
}