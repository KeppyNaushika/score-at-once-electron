generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                     String                 @id @default(uuid())
  username               String                 @unique
  passcode               String?
  name                   String
  role                   String                 @default("teacher")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  passcodeType           String?                @default("none")
  questionScores         QuestionScore[]
  userExams              UserExam[]
  invitedUserExams       UserExam[]             @relation("InvitedByUser")
  keyboardShortcuts      UserKeyboardShortcut[]
  preferences            UserPreference[]
  answerSheetDefinitions AsbDefinition[]
  compoundAnswerScores   CompoundAnswerScore[]
  scoreDecisions         ScoreDecision[]
  gradeFrozenScores      GradeFrozenScore[]
  cropRegionAssignments  CropRegionAssignment[]
  assignedCropRegions    CropRegionAssignment[] @relation("AssignedByUser")
}

model Classroom {
  id                   String                       @id @default(uuid())
  name                 String                       @unique
  classroomCode        String?
  grade                Int?
  description          String?
  isVisible            Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  memberships          StudentClassroomMembership[]
  examClassrooms       ExamClassroom[]
  gradeClassrooms      GradeClassroom[]
  courseworkClassrooms CourseworkClassroom[]
}

model Student {
  id                 String                       @id @default(uuid())
  studentNumber      String                       @unique
  lastName           String
  firstName          String
  lastNameKana       String
  firstNameKana      String
  enrollmentYear     Int?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  examStudents       ExamStudent[]
  memberships        StudentClassroomMembership[]
  gradeStudents      GradeStudent[]
  courseworkStudents CourseworkStudent[]
}

model StudentClassroomMembership {
  id               String    @id @default(uuid())
  studentId        String
  classroomId      String
  startDate        DateTime  @default(now())
  endDate          DateTime?
  attendanceNumber Int?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom        Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classroomId])
  @@index([classroomId, attendanceNumber])
  @@index([startDate, endDate])
}

model Exam {
  id                                    String                                    @id @default(uuid())
  examName                              String
  examDate                              DateTime?
  description                           String?
  /// 答案アップロード時にOMRマーカーによる位置補正を既定でONにするか（ASB由来かつomrMarkers有効な試験はtrue）
  markerCorrectionEnabled               Boolean                                   @default(false)
  createdAt                             DateTime                                  @default(now())
  updatedAt                             DateTime                                  @default(now()) @updatedAt
  examPages                             ExamPage[]
  examStudents                          ExamStudent[]
  examSubtotalGroups                    ExamSubtotalGroup[]
  userExams                             UserExam[]
  examClassrooms                        ExamClassroom[]
  answerOverlayStyles                   ExamAnswerOverlayStyle[]
  answerOverlayVisibilities             ExamAnswerOverlayVisibility[]
  individualReportSettings              ExamIndividualReportSettings?
  individualReportTableSections         ExamIndividualReportTableSection[]
  individualReportGraphSettings         ExamIndividualReportGraphSettings?
  individualReportStatisticVisibilities ExamIndividualReportStatisticVisibility[]
  gradeDataSources                      GradeDataSource[]
  examTags                              ExamTag[]
}

/// 試験の受験対象者。答案・採点・確定・返却スナップショットはすべてこの行を親とする
/// （Student 直結にすると、試験から外した生徒の採点データが孤児として残り、
/// 試験側には現れないのに成績算出でだけ算入されてしまうため）。
model ExamStudent {
  id                   String                @id @default(uuid())
  examId               String
  studentId            String
  status               String
  customOrder          Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  exam                 Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  student              Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentAnswerImages  StudentAnswerImage[]
  questionScores       QuestionScore[]
  scoreDecisions       ScoreDecision[]
  compoundAnswerScores CompoundAnswerScore[]
  returnSnapshots      ReturnSnapshot[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([examId, customOrder])
}

/// 解答用紙の1ページ。模範解答画像そのものを持つ。
///
/// かつて画像は MasterImage という別テーブルにあったが、ExamPage 1件に対し必ず1枚で、
/// 2枚以上になる経路も、複数枚を使う読み取りも存在しなかった。1:N のままだったせいで
/// 読む側は全箇所が `masterImages[0]` を書き、インポートは unique 制約の代わりに手書きの
/// 重複チェックを持ち、削除は「残り0枚なら」を数えていた。畳んで ExamPage = 1ページとした。
///
/// アプリの操作では模範解答の無いページを新たに作れない。削除はページごと消し、画像を
/// 取り替えたいだけなら差し替え（replaceMasterAnswerImage）を使う。それでも imagePath を
/// nullable にしているのは、旧バージョンが「答案画像が残っているページから模範解答だけを
/// 消す」ことを許しており、そのページを移行時に消すと答案と採点結果まで道連れになるため。
/// **空文字を「画像なし」の代わりに使ってはいけない** — 型が string を主張してしまい、
/// 画像を読む側が欠落の分岐を書き忘れてもコンパイルが通る。null なら型が分岐を強制する。
model ExamPage {
  id         String  @id @default(uuid())
  examId     String
  pageNumber Int
  /// 模範解答画像のパス（data ディレクトリからの相対）。旧バージョンで模範解答だけを
  /// 削除されたページは null。画像を読む前に必ず有無を確かめること
  imagePath  String?
  /// 用紙サイズ。注釈のmm換算の基準になるため描画経路すべてで一致させること
  pageSize   String  @default("A4")

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  cropRegions         CropRegion[]
  studentAnswerImages StudentAnswerImage[]
  compoundAnswers     CompoundAnswer[]
  exam                Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// 答案画像
model StudentAnswerImage {
  id            String      @id @default(uuid())
  examPageId    String
  examStudentId String
  imagePath     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  examPage      ExamPage    @relation(fields: [examPageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examStudent   ExamStudent @relation(fields: [examStudentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([examPageId, examStudentId])
  @@index([examPageId])
  @@index([examStudentId])
}

model CropRegion {
  id                 String                 @id @default(uuid())
  examPageId         String
  label              String
  type               String
  x                  Float
  y                  Float
  width              Float
  height             Float
  points             Int?
  orderIndex         Int?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt
  examPage           ExamPage               @relation(fields: [examPageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cropSubtotals      CropSubtotal[]
  questionScores     QuestionScore[]
  gradeDataSources   GradeDataSource[]
  omrConfig          CropRegionOmrConfig?
  compoundMembership CompoundAnswerMember?
  scoreDecisions     ScoreDecision[]
  assignments        CropRegionAssignment[]
}

/// 設問（採点領域）ごとの採点担当。1設問に複数担当を許す（ダブルチェック）。
///
/// 担当は権限拒否ではなく「その人が採点画面で選べる設問集合」を定義する。
/// 担当が0人の設問は全員担当とみなす（割当漏れによる採点不能の回避と、
/// 割当を使っていない既存試験の後方互換）。
///
/// 2端末が同じ(設問, 担当者)ペアを割り当てるとid違い・`@@unique`同値の行ができるが、
/// これは sqlite-nas-sync が解決する（`conflict.ts` の applyInsert が敗者行をLWWで
/// 削除し、DELETEトリガー経由で全クライアントが勝者へ収束する）。idは uuidv4 でよい。
model CropRegionAssignment {
  id           String     @id @default(uuid())
  cropRegionId String
  userId       String
  /// 割り当てたOWNER（監査用）。ユーザー削除時はnullにして割当自体は残す
  assignedBy   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  cropRegion   CropRegion @relation(fields: [cropRegionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigner     User?      @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([cropRegionId, userId])
  @@index([userId])
}

model SubtotalGroup {
  id                 String              @id @default(uuid())
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  examSubtotalGroups ExamSubtotalGroup[]
  subtotals          Subtotal[]
  tagSubtotalGroups  TagSubtotalGroup[]
}

model Subtotal {
  id               String            @id @default(uuid())
  name             String
  subtotalGroupId  String
  order            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  cropSubtotals    CropSubtotal[]
  subtotalGroup    SubtotalGroup     @relation(fields: [subtotalGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gradeDataSources GradeDataSource[]

  @@unique([subtotalGroupId, name], map: "sqlite_autoindex_Subtotal_2")
}

model CropSubtotal {
  id             String     @id @default(uuid())
  cropRegionId   String
  subtotalId     String
  assignmentType String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  cropRegion     CropRegion @relation(fields: [cropRegionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subtotal       Subtotal   @relation(fields: [subtotalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model UserExam {
  id        String   @id @default(uuid())
  userId    String
  examId    String
  role      String   @default("GRADER") // "OWNER" | "GRADER"
  invitedAt DateTime @default(now())
  invitedBy String? // Null for OWNER (exam creator)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter   User?    @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([userId, examId])
  @@index([examId])
}

/// 試験で使う小計点グループ。どの集計に含めるかのフラグを持つ。
///
/// 2端末が同じ(試験, 小計点グループ)を追加するとid違い・`@@unique`同値の行ができるが、
/// これは sqlite-nas-sync が解決する（敗者行をLWWで削除して1行へ収束させる）。
/// 書き込みは必ず `@@unique` を鍵に upsert すること（idは同定に使わない）。
model ExamSubtotalGroup {
  id                 String        @id @default(uuid())
  examId             String
  subtotalGroupId    String
  selectedForTable   Boolean       @default(false) // 小計点テーブルに含めるグループ
  selectedForBoxPlot Boolean       @default(false) // 箱ひげ図に含めるグループ
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  exam               Exam          @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subtotalGroup      SubtotalGroup @relation(fields: [subtotalGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([examId, subtotalGroupId])
  @@index([examId])
  @@index([subtotalGroupId])
}

model QuestionScore {
  id                 String              @id @default(uuid())
  cropRegionId       String
  examStudentId      String
  partialScore       Decimal?
  status             String              @default("unscored")
  userId             String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  drawingAnnotations DrawingAnnotation[]
  cropRegion         CropRegion          @relation(fields: [cropRegionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examStudent        ExamStudent         @relation(fields: [examStudentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user               User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([examStudentId])
}

/// 生徒×設問ごとの確定スコア（試験OWNERによる裁定）。
/// QuestionScore（採点者ごとの提案）とは別に1セル1行で保持し、upsertのみで運用する
/// （削除・再作成しない — LWW同期でセカンダリUNIQUEにより単一行へ収束させるため）。
model ScoreDecision {
  id                    String      @id @default(uuid())
  cropRegionId          String
  examStudentId         String
  /// 確定した採点判定（correct | incorrect | partial | pending | no_answer | double_mark）
  verdict               String
  /// 確定点。correct等のverdict自体が点数を決める場合はnull可
  score                 Decimal?
  comment               String?
  decidedByUserId       String
  decidedAt             DateTime    @default(now())
  /// 採用元の提案（QuestionScore）のID。手入力で確定した場合はnull
  sourceQuestionScoreId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @default(now()) @updatedAt
  cropRegion            CropRegion  @relation(fields: [cropRegionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examStudent           ExamStudent @relation(fields: [examStudentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decidedBy             User        @relation(fields: [decidedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cropRegionId, examStudentId])
  @@index([examStudentId])
}

/// 答案上の手書き採点マーク（テキスト・直線・長方形・楕円）。
/// 持ち主は親 QuestionScore（生徒×設問×採点者で1行）から一意に決まるので、
/// 自前の userId は持たない。採点者で絞るときは questionScore.userId を辿る。
model DrawingAnnotation {
  id              String        @id @default(uuid())
  questionScoreId String
  type            String
  x               Float
  y               Float
  color           String        @default("#ef4444")
  strokeWidth     Float         @default(0.5)
  width           Float         @default(0.0)
  height          Float         @default(0.0)
  endX            Float         @default(0.0)
  endY            Float         @default(0.0)
  lineStyle       String        @default("solid")
  text            String        @default("")
  fontSize        Float         @default(4.0)
  textBoxWidth    Float         @default(0.0)
  textBoxHeight   Float         @default(0.0)
  horizontalAlign String        @default("left")
  verticalAlign   String        @default("top")
  anchorDirection String        @default("top-left")
  displayX        Float         @default(0.0)
  displayY        Float         @default(0.0)
  isFavorite      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questionScore   QuestionScore @relation(fields: [questionScoreId], references: [id], onDelete: Cascade)

  @@index([questionScoreId])
  @@index([type])
  @@index([createdAt])
  @@index([isFavorite])
}

/// 答案返却（公式出力）時点の有効スコア＋手書き注釈のスナップショット。
/// 「返却版として記録」操作のたびに生徒×試験ごとに1行を upsert で上書きする
/// （最新の返却版のみ保持）。再印刷時はこれを基準に現在状態との差分を取り、
/// 変更があった生徒だけを絞り込む。scoresJson は resolveEffectiveScores() の出力と
/// 印刷対象の DrawingAnnotation を正規化シリアライズした文字列。
model ReturnSnapshot {
  id               String      @id @default(uuid())
  examStudentId    String      @unique
  /// 有効スコア＋注釈の正規化JSON（直接比較で差分判定する）
  scoresJson       String
  /// 返却時点の合計点（表示用。null可）
  totalScore       Decimal?
  /// 返却操作を行った操作者。システム操作はnull
  capturedByUserId String?
  /// 返却版として記録した日時（ISO text）
  capturedAt       DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  examStudent      ExamStudent @relation(fields: [examStudentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// 監査ログ（Discord風の操作履歴）。
/// 追記専用・不変。状態を変える全操作とエクスポートを記録する（閲覧は対象外）。
/// userIdはFKを張らず素の文字列とし、ユーザー削除後もログが残るようにする。
model AuditLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) // 初回操作日時（ISO text）
  updatedAt   DateTime @updatedAt // 最終更新日時。連続操作の集約時に上書きされる（LWW同期のタイムスタンプ列）
  userId      String? // 操作者。システム操作はnull
  action      String // "exam.update" / "grade.boundary.update" 等の名前空間付きアクション
  category    String // "exam" | "grade" | "answer_sheet" | "student" | "user" | "system"
  scopeId     String? // 絞り込み用の親エンティティID（examId / gradeId / definitionId 等）
  scopeLabel  String? // 表示用スナップショット（対象が消えても残す。"数学 期末" 等）
  entityType  String // 変更対象のテーブル名（"Exam" 等）
  entityId    String // 変更対象のレコードID
  summary     String // 人間可読の要約（構造化レンダリングのフォールバック）
  metadata    String? // JSON: { changes:[{field,label,before,after}], occurrences, target:{...} }
  coalesceKey String? // 連続操作の集約キー（同一キーの行を窓内で上書き更新）。indexで高速一致

  @@index([createdAt])
  @@index([updatedAt])
  @@index([userId])
  @@index([category])
  @@index([scopeId])
  @@index([action])
  @@index([coalesceKey])
}

model ExamClassroom {
  id                String   @id @default(uuid())
  examId            String
  classroomId       String
  administered      Boolean  @default(false) // 学級・出席番号表示（再採番）の対象
  teacherStatistics Boolean  @default(false) // 教員集計対象（Excel学級平均行）
  studentReport     Boolean  @default(false) // 生徒表示対象（個人成績表の学級比較）
  order             Int      @default(0) // 複数クラス時の優先順位（小さいほど優先）
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([examId, classroomId])
  @@index([examId])
  @@index([classroomId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tagSubtotalGroups TagSubtotalGroup[]
  examTags          ExamTag[]
  courseworkTags    CourseworkTag[]
  asbDefinitionTags AsbDefinitionTag[]
}

model TagSubtotalGroup {
  id              String   @id @default(uuid())
  tagId           String
  subtotalGroupId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  subtotalGroup SubtotalGroup @relation(fields: [subtotalGroupId], references: [id], onDelete: Cascade)

  @@unique([tagId, subtotalGroupId])
  @@index([tagId])
  @@index([subtotalGroupId])
}

model ExamTag {
  id        String   @id @default(uuid())
  examId    String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([examId, tagId])
  @@index([examId])
  @@index([tagId])
}

/// 解答用紙定義のタグ（既存 Tag と多対多）
model AsbDefinitionTag {
  id              String   @id @default(uuid())
  asbDefinitionId String
  tagId           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asbDefinition AsbDefinition @relation(fields: [asbDefinitionId], references: [id], onDelete: Cascade)
  tag           Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([asbDefinitionId, tagId])
  @@index([asbDefinitionId])
  @@index([tagId])
}

model UserKeyboardShortcut {
  id        String   @id @default(uuid())
  userId    String
  action    String
  key       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
  @@index([userId])
}

model UserPreference {
  id     String @id @default(uuid())
  userId String
  key    String
  value  String // JSON文字列で保存

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/// 答案に重ねて描く要素（採点マーク・設問の点数・小計・合計）の配置と見た目。
/// overlayKind ごとに1行。position/anchor は3×3の基準点（src/types/scoringOverlay.types.ts）
model ExamAnswerOverlayStyle {
  id          String   @id @default(uuid())
  examId      String
  overlayKind String // "mark" | "partial" | "subtotal" | "total"
  position    String // 領域内のどこに置くか
  anchor      String // 描画物のどの点を position に合わせるか
  offsetX     Int
  offsetY     Int
  size        Int // マークは画像の一辺、点数はフォントサイズ
  color       String // HEX #RRGGBB
  opacity     Int // 0-100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, overlayKind])
  @@index([examId])
}

/// 採点状態ごとに、答案へマーク／点数を描くか
model ExamAnswerOverlayVisibility {
  id        String   @id @default(uuid())
  examId    String
  status    String // ScoringStatus（src/types/scoringStatus.types.ts）
  showMark  Boolean
  showScore Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, status])
  @@index([examId])
}

/// 個人成績表に何を載せ、どう組むか（試験ごとに1行）
model ExamIndividualReportSettings {
  id     String @id @default(uuid())
  examId String @unique

  displayMode String // "detail" | "subtotal_only"

  showScore Boolean
  showMarks Boolean

  hideUnassignedSubtotals Boolean
  showGroupSubtotals      Boolean
  showCorrectRate         Boolean
  showScoreRate           Boolean

  showLearningAdvice        Boolean
  adviceReviewRateMin       Float?
  adviceReviewRateMax       Float?
  adviceReviewQuestionCount Int?

  showComment   Boolean
  showSignature Boolean

  pageLayout      String // "auto" | "single" | "double"
  pageOrientation String // "portrait" | "landscape"

  /// 小計点テーブル・箱ひげ図それぞれの「グループ選択を使うか」。
  /// 選択されたグループ自体は ExamSubtotalGroup のフラグが正
  tableGroupSelectionEnabled Boolean

  /// 統計（平均・偏差値・順位・箱ひげ図）の母集団に含める受験状態。
  /// ExamStudentStatus は3値固定でコードも名前で引くため列で持つ
  statisticsIncludesParticipating Boolean
  statisticsIncludesExpected      Boolean
  statisticsIncludesAbsent        Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

/// 個人成績表の表形式の節（小計点テーブル／設問テーブル）
model ExamIndividualReportTableSection {
  id        String   @id @default(uuid())
  examId    String
  tableKind String // "subtotal" | "question"
  enabled   Boolean
  columns   Int // 1-10
  fontSize  Int // px
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, tableKind])
  @@index([examId])
}

/// 個人成績表の統計を、種別（平均・偏差値・順位・箱ひげ図）×
/// 母集団（所属学級ごと・全体）の組で出すかどうか。
/// 学級は複数ありうるので "classroom" は「所属学級それぞれ」を意味する。
/// どの学級かは ExamClassroom.studentReport が決める（ここは学級を参照しない）
model ExamIndividualReportStatisticVisibility {
  id            String   @id @default(uuid())
  examId        String
  statisticKind String // "average" | "deviation" | "rank" | "boxPlot"
  scope         String // "classroom" | "overall"
  shown         Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, statisticKind, scope])
  @@index([examId])
}

/// 個人成績表のグラフ設定（試験ごとに1行）
model ExamIndividualReportGraphSettings {
  id     String @id @default(uuid())
  examId String @unique

  showBarChart                 Boolean
  showRadarChart               Boolean
  /// 合計点の箱ひげ図（小計別とは別に先頭へ足す。母集団の話ではない）
  showTotalScoreBoxPlot        Boolean
  /// 箱ひげ図に載せる小計グループを絞り込むか（選択自体は ExamSubtotalGroup のフラグ）
  boxPlotGroupSelectionEnabled Boolean

  showBoxPlotMin    Boolean
  showBoxPlotQ1     Boolean
  showBoxPlotMedian Boolean
  showBoxPlotQ3     Boolean
  showBoxPlotMax    Boolean
  showAverageLine   Boolean
  showStudentMarker Boolean

  boxPlotFontSize   Int
  boxPlotItemHeight Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

/// CropRegionに紐づくOMR設定（1:1）
model CropRegionOmrConfig {
  id             String   @id @default(uuid())
  cropRegionId   String   @unique
  type           String // "choice"（旧 "handwritten-digit" は #1103 で廃止）
  numChoices     Int? // choice: 選択肢数(2-10)
  choiceLayout   String? // "horizontal" | "vertical"
  colorThreshold Int? // 認識パラメータ上書き
  areaThreshold  Float? // 認識パラメータ上書き
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cropRegion    CropRegion                  @relation(fields: [cropRegionId], references: [id], onDelete: Cascade)
  choiceOptions CropRegionOmrChoiceOption[]

  @@index([cropRegionId])
}

/// OMR選択肢オプション（choiceタイプ用）— バブル位置情報を含む
model CropRegionOmrChoiceOption {
  id               String   @id @default(uuid())
  omrConfigId      String
  choiceIndex      Int
  label            String // "ア","イ" etc.
  isCorrect        Boolean  @default(false)
  shape            String?  @default("ellipse") // "ellipse" | "rectangle" | "circle"
  normalizedCx     Float? // バブル中心X (0-1正規化)
  normalizedCy     Float? // バブル中心Y (0-1正規化)
  normalizedWidth  Float? // バブル幅 (0-1正規化)
  normalizedHeight Float? // バブル高さ (0-1正規化)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  omrConfig CropRegionOmrConfig @relation(fields: [omrConfigId], references: [id], onDelete: Cascade)

  @@unique([omrConfigId, choiceIndex])
  @@index([omrConfigId])
}

/// OMR数字欄位置（handwritten-digitタイプ用）
/// 複合回答グループ（共通テスト数学の分数、SAT Grid-Inなど）
/// 複数のCropRegionを1つの論理的な回答としてグループ化
model CompoundAnswer {
  id                 String   @id @default(uuid())
  examPageId         String
  label              String // "アイ/ウエ", "Grid-In #1"
  answerFormat       String // "fraction" | "multi-digit" | "grid-in"
  correctAnswer      String // "-3/14", "42"
  points             Int      @default(0)
  orderIndex         Int?
  alternativeAnswers String? // カンマ区切りの別解 (.667,.6667)
  requireReduced     Boolean  @default(false) // 約分必須か（共通テスト: true）
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  examPage ExamPage               @relation(fields: [examPageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members  CompoundAnswerMember[]
  scores   CompoundAnswerScore[]

  @@index([examPageId])
}

/// 複合回答のメンバー（CompoundAnswer と CropRegion の紐付け）
model CompoundAnswerMember {
  id               String   @id @default(uuid())
  compoundAnswerId String
  cropRegionId     String   @unique // 1つのCropRegionは最大1つのCompoundAnswerに所属
  order            Int // グループ内での連結順序
  roleLabel        String? // "ア", "分子1桁目" 等
  separator        String? // この列の後に挿入する文字 ("/" 等)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  compoundAnswer CompoundAnswer @relation(fields: [compoundAnswerId], references: [id], onDelete: Cascade)
  cropRegion     CropRegion     @relation(fields: [cropRegionId], references: [id], onDelete: Cascade)

  @@index([compoundAnswerId])
}

/// 複合回答の採点結果（CompoundAnswer単位で1生徒1スコア）
model CompoundAnswerScore {
  id               String   @id @default(uuid())
  compoundAnswerId String
  examStudentId    String
  userId           String
  recognizedAnswer String? // 組み立てた回答文字列
  status           String   @default("unscored")
  partialScore     Decimal?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  compoundAnswer CompoundAnswer @relation(fields: [compoundAnswerId], references: [id], onDelete: Cascade)
  examStudent    ExamStudent    @relation(fields: [examStudentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([compoundAnswerId, examStudentId])
  @@index([compoundAnswerId])
  @@index([examStudentId])
}

/// 成績算出プロジェクト
model Grade {
  id            String    @id @default(uuid())
  name          String
  description   String?
  referenceDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gradeItems       GradeItem[]
  gradeClassrooms  GradeClassroom[]
  gradeStudents    GradeStudent[]
  gradeConstraints GradeConstraint[]
  exportSettings   GradeExportSettings?
}

/// 観点間の制約ルール（不適切な観点/評定の組合せを検知して着色）
///
/// 旧 `config`（kind別の設定JSON）は評価項目を「名前」で参照していたため、項目を
/// リネームすると制約が失効した。集計対象（viewpointItems）は失効しても検証されず、
/// 一部だけ空振りすると残りだけで平均を取って判定が通っていた。id参照へ昇格して
/// リレーションで守る（issue #1063）。
model GradeConstraint {
  id                String   @id @default(uuid())
  gradeId           String
  name              String
  kind              String // "consistency" | "mutual_exclusion" | "expression"
  /// kind="consistency": 比較先の「評定」項目。項目削除時はnullにし、ルール自体は残して
  /// 「評定が未選択」として検知させる（黙って違反なしにしない）
  targetGradeItemId String?
  /// kind="consistency": 観点の集計方法 "average" | "sum"
  aggregate         String   @default("average")
  /// kind="consistency": 評定との許容差（これを超えたら違反）
  tolerance         Decimal  @default(1)
  expression        String   @default("") // kind="expression" 時のみ使用
  color             String // 着色色（hex等）
  /// 違反時に表示する教員の説明文。移行や取り込みの診断はここへ書かない
  message           String?
  /// 移行・取り込み・項目削除でこのルールを自動で無効化したときの理由。
  /// message（教員が書いた違反の説明。結果表のツールチップに出る）を汚さないよう別に持つ
  disabledReason    String?
  enabled           Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  grade           Grade                           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  targetGradeItem GradeItem?                      @relation("GradeConstraintTarget", fields: [targetGradeItemId], references: [id], onDelete: SetNull)
  viewpoints      GradeConstraintViewpoint[]
  labelValues     GradeConstraintLabelValue[]
  exclusionLabels GradeConstraintExclusionLabel[]

  @@index([gradeId])
  @@index([targetGradeItemId])
}

/// consistency ルールの集計対象となる観点（旧 config.viewpointItems）。
/// 空なら target 以外の全項目を対象にする、という既定の意味は評価側が持つ。
///
/// 2端末が同じ(ルール, 項目)を追加するとid違い・`@@unique`同値の行ができるが、これは
/// sqlite-nas-sync が解決する（敗者行をLWWで削除して1行へ収束させる）。
/// 書き込みは必ず `@@unique` を鍵に upsert すること（idは同定に使わない）。
model GradeConstraintViewpoint {
  id           String   @id @default(uuid())
  constraintId String
  gradeItemId  String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  constraint GradeConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)
  gradeItem  GradeItem       @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)

  @@unique([constraintId, gradeItemId])
  @@index([constraintId])
  @@index([gradeItemId])
}

/// consistency ルールのラベル→数値の対応（旧 config.labelValues。例 A=5, B=3, C=1）。
/// labelは境界ラベルの文字列であり実体参照ではないため、そのまま値として持つ。
/// idは uuidv4。競合の扱いは GradeConstraintViewpoint と同じ。
model GradeConstraintLabelValue {
  id           String   @id @default(uuid())
  constraintId String
  label        String
  value        Decimal
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  constraint GradeConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)

  @@unique([constraintId, label])
  @@index([constraintId])
}

/// mutual_exclusion ルールの混在禁止ラベル集合（旧 config.labels。例 ["A", "C"]）。
/// idは uuidv4。競合の扱いは GradeConstraintViewpoint と同じ。
model GradeConstraintExclusionLabel {
  id           String   @id @default(uuid())
  constraintId String
  label        String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  constraint GradeConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)

  @@unique([constraintId, label])
  @@index([constraintId])
}

/// 評価項目（知識・技能、思考・判断・表現、評定 等）
model GradeItem {
  id        String   @id @default(uuid())
  gradeId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grade                Grade                      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  dataSources          GradeDataSource[]
  boundaries           GradeItemBoundary[]
  overrides            GradeOverride[]
  frozenScores         GradeFrozenScore[]
  itemExclusions       GradeItemExclusion[]
  constraintTargets    GradeConstraint[]          @relation("GradeConstraintTarget")
  constraintViewpoints GradeConstraintViewpoint[]

  @@index([gradeId])
}

/// 成績算出プロジェクトの対象学級
model GradeClassroom {
  id          String   @id @default(uuid())
  gradeId     String
  classroomId String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade     Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([gradeId, classroomId])
  @@index([gradeId])
  @@index([classroomId])
}

/// 成績算出プロジェクトの対象生徒
model GradeStudent {
  id          String   @id @default(uuid())
  gradeId     String
  studentId   String
  customOrder Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade          Grade                @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  student        Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overrides      GradeOverride[]
  frozenScores   GradeFrozenScore[]
  itemExclusions GradeItemExclusion[]

  @@unique([gradeId, studentId])
  @@index([gradeId])
  @@index([studentId])
  @@index([gradeId, customOrder])
}

/// 成績データソース（6種: exam_total / subtotal / crop_region / coursework / coursework_total）
/// coursework型は CourseworkItem（試験外成績資料の評価項目）を参照する
/// coursework_total型は Coursework（試験外成績資料）全体を参照し、全評価項目のスコアを合算する
///
/// 参照列（examId / subtotalId / cropRegionId / courseworkItemId / courseworkId）は
/// type ごとに使う組み合わせが変わり、**同じ列でも type によって意味が違う**。
/// 特に examId は type によって必要だったり冗長だったりするので、消さないこと。
///
/// | type             | 参照列                    | examId の意味                                  |
/// | ---------------- | ------------------------- | ---------------------------------------------- |
/// | exam_total       | examId                    | 合計点を取る試験そのもの（必須）               |
/// | subtotal         | examId + subtotalId       | **必須**。SubtotalGroup は Exam と多対多なので、|
/// |                  |                           | どの試験のスコアを集計するかは subtotalId から |
/// |                  |                           | は辿れない                                     |
/// | crop_region      | examId + cropRegionId     | 冗長（cropRegion.examPage.examId で辿れる）    |
/// | coursework       | courseworkItemId          | 使わない                                       |
/// | coursework_total | courseworkId              | 使わない                                       |
model GradeDataSource {
  id                     String   @id @default(uuid())
  gradeItemId            String
  type                   String // "exam_total" | "subtotal" | "crop_region" | "coursework" | "coursework_total"
  examId                 String?
  subtotalId             String?
  cropRegionId           String?
  courseworkItemId       String?
  courseworkId           String?
  name                   String
  weight                 Decimal
  order                  Int      @default(0)
  absentMethod           String   @default("null")
  absentRatio            Decimal  @default(1.0)
  absentOffset           Decimal  @default(0)
  treatExpectedAsMissing Boolean  @default(false)
  estimationMode         String   @default("all") // "all" | "selected"
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  gradeItem      GradeItem       @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  exam           Exam?           @relation(fields: [examId], references: [id], onDelete: SetNull)
  subtotal       Subtotal?       @relation(fields: [subtotalId], references: [id], onDelete: Cascade)
  cropRegion     CropRegion?     @relation(fields: [cropRegionId], references: [id], onDelete: Cascade)
  courseworkItem CourseworkItem? @relation(fields: [courseworkItemId], references: [id], onDelete: SetNull)
  coursework     Coursework?     @relation(fields: [courseworkId], references: [id], onDelete: SetNull)

  /// estimationMode="selected" のとき推定に使う他データソース（旧 estimationSourceIds のJSON配列）
  estimationSources      GradeDataSourceEstimationSource[] @relation("EstimationTarget")
  /// 自分を推定材料として参照している側（削除時のカスケード用）
  estimationReferencedBy GradeDataSourceEstimationSource[] @relation("EstimationSource")

  @@index([gradeItemId])
  @@index([examId])
  @@index([subtotalId])
  @@index([cropRegionId])
  @@index([courseworkItemId])
  @@index([courseworkId])
}

/// 欠損推定に使う他データソース（旧 GradeDataSource.estimationSourceIds のJSON配列）。
/// JSON配列ではFKが効かず、参照先データソースを削除してもdangling idが残っていた（issue #1063）。
///
/// idは uuidv4。競合の扱いは GradeConstraintViewpoint と同じ。
model GradeDataSourceEstimationSource {
  id                 String   @id @default(uuid())
  /// 推定を行う側
  dataSourceId       String
  /// 推定の材料に使う側（同一Grade内の他データソース）
  sourceDataSourceId String
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dataSource       GradeDataSource @relation("EstimationTarget", fields: [dataSourceId], references: [id], onDelete: Cascade)
  sourceDataSource GradeDataSource @relation("EstimationSource", fields: [sourceDataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, sourceDataSourceId])
  @@index([dataSourceId])
  @@index([sourceDataSourceId])
}

/// 評価項目ごとの対象生徒除外設定
/// 評価項目を成績算出から外す設定。対象は「その成績の対象者（GradeStudent）× 評価項目」で、
/// 人（Student）ではない。名簿から外された生徒の除外設定は存在しえない（#962）。
model GradeItemExclusion {
  id             String   @id @default(uuid())
  gradeStudentId String
  gradeItemId    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gradeStudent GradeStudent @relation(fields: [gradeStudentId], references: [id], onDelete: Cascade)
  gradeItem    GradeItem    @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)

  @@unique([gradeStudentId, gradeItemId])
  @@index([gradeStudentId])
  @@index([gradeItemId])
}

/// 成績ラベルの手動上書き（生徒×評価項目）。総合の行は持たない（GradeBoundary と同じ理由）
/// 成績ラベルの手動上書き。対象は「その成績の対象者（GradeStudent）× 評価項目」で、
/// 人（Student）ではない。名簿から外された生徒の上書きは存在しえない（#962）。
model GradeOverride {
  id             String   @id @default(uuid())
  gradeStudentId String
  gradeItemId    String
  overrideLabel  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gradeStudent GradeStudent @relation(fields: [gradeStudentId], references: [id], onDelete: Cascade)
  gradeItem    GradeItem    @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)

  @@unique([gradeStudentId, gradeItemId])
  @@index([gradeStudentId])
  @@index([gradeItemId])
}

/// 成績値の確定（凍結）。確定操作を行った時点の実効値（自動算出 → 手動上書きを適用した後の値）を
/// そのまま保存し、以後は参照資料（試験スコア・試験外成績資料）や境界設定を変更しても追従させない。
///
/// GradeOverride とは意味論が別なので相乗りしない — あちらは「教員が評定を意図的に変えた」という
/// 調整の記録で、こちらは「その調整の結果を含む今の値をこれで確定する」という凍結。
/// 算出時の採用順は 確定値 > 手動上書き > リアルタイム算出値。
///
/// 対象は「その成績の対象者（GradeStudent）× 評価項目」のみ。人（Student）ではないので、
/// 名簿から外された生徒の確定値は存在しえない（#962。以前は外して再追加すると確定値が甦った）。
/// 総合（overall）の行は作らない — 総合の境界セットを作る導線が UI に存在せず評定自体が
/// GradeItem の一つとして運用されているため。これにより gradeItemId を NOT NULL にでき、
/// SQLite が unique 制約で NULL を互いに別物と扱う罠も踏まない。
model GradeFrozenScore {
  id             String @id @default(uuid())
  gradeStudentId String
  gradeItemId    String

  /// 確定時の重み付け得点。全ソース欠測など算出不能なら null
  weightedScore    Decimal?
  /// 確定時の重み付け満点（重みの合計）
  weightedMaxScore Decimal
  /// 確定時の達成率(%)。算出不能なら null
  percentage       Decimal?
  /// 確定時の成績ラベル。境界未設定なら null
  gradeLabel       String?

  /// 確定操作を行った操作者。システム操作は null
  frozenByUserId String?
  frozenAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  gradeStudent GradeStudent @relation(fields: [gradeStudentId], references: [id], onDelete: Cascade)
  gradeItem    GradeItem    @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  frozenBy     User?        @relation(fields: [frozenByUserId], references: [id], onDelete: SetNull)

  @@unique([gradeStudentId, gradeItemId])
  @@index([gradeStudentId])
  @@index([gradeItemId])
}

/// 評価項目ごとの成績境界。「このパーセンテージ以上ならこのラベル」を1行で表す。
///
/// 境界の有無は行の有無そのもの。以前は属性を持たない容器 GradeBoundarySet を挟んでいたが、
/// あれは「総合（overall）」— 評価項目に属さない境界 — を置くための入れ物で、総合の撤去
/// （20260725170000）で存在理由を失っていた。容器を残すと境界0件のセット行が生き残り、
/// 「境界は無いのに設定済み」という状態が作れてしまう。
///
/// 「総合」という対象は持たない — 評定は評価項目（GradeItem）の一つとして扱うのが本来で、
/// 総合は全評価項目の加重平均という意味を成さない集計だった（評定そのものを観点と一緒に
/// 平均へ混ぜていた）。UI にも総合の境界を作る導線が無く、残っていたのは残骸。
///
/// gradeId は持たない。所属する成績は gradeItem.gradeId から辿れる冗長列でしかない。
model GradeItemBoundary {
  id            String   @id @default(uuid())
  gradeItemId   String
  label         String
  minPercentage Decimal
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gradeItem GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)

  @@index([gradeItemId])
}

/// 成績算出プロジェクトのエクスポート設定
model GradeExportSettings {
  id           String   @id @default(uuid())
  gradeId      String   @unique
  settingsJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 試験外成績資料（Coursework）— Exam / SubtotalGroup と同階層のトップレベル実体
// =============================================================================

/// 試験外成績資料（例「第2回レポート」）。評価項目を複数持ち、点数を自分で保持する。
/// 成績算出（Grade）からは CourseworkItem 単位で参照され、点数そのものを共有・再利用する。
model Coursework {
  id          String    @id @default(uuid())
  name        String
  description String?
  date        DateTime? // 実施日（任意）: 在籍判定・並びに使用
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classrooms       CourseworkClassroom[]
  students         CourseworkStudent[]
  tags             CourseworkTag[]
  items            CourseworkItem[]
  gradeDataSources GradeDataSource[]
}

/// 試験外成績資料の対象学級
model CourseworkClassroom {
  id           String   @id @default(uuid())
  courseworkId String
  classroomId  String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursework Coursework @relation(fields: [courseworkId], references: [id], onDelete: Cascade)
  classroom  Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([courseworkId, classroomId])
  @@index([courseworkId])
  @@index([classroomId])
}

/// 試験外成績資料の対象生徒（名簿）。点数が項目ごとに複数つくため名簿は独立テーブル。
model CourseworkStudent {
  id           String   @id @default(uuid())
  courseworkId String
  studentId    String
  customOrder  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursework Coursework        @relation(fields: [courseworkId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scores     CourseworkScore[]

  @@unique([courseworkId, studentId])
  @@index([courseworkId])
  @@index([studentId])
  @@index([courseworkId, customOrder])
}

/// 試験外成績資料のタグ（既存 Tag と多対多）
model CourseworkTag {
  id           String   @id @default(uuid())
  courseworkId String
  tagId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursework Coursework @relation(fields: [courseworkId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([courseworkId, tagId])
  @@index([courseworkId])
  @@index([tagId])
}

/// 試験外成績資料の評価項目（知識/思考…）。各項目が満点・数値/文字・変換表を持つ。
model CourseworkItem {
  id           String   @id @default(uuid())
  courseworkId String
  name         String
  order        Int      @default(0)
  maxScore     Decimal
  inputMode    String   @default("numeric") // "numeric" | "letter"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursework       Coursework              @relation(fields: [courseworkId], references: [id], onDelete: Cascade)
  scores           CourseworkScore[]
  letterScales     CourseworkLetterScale[]
  gradeDataSources GradeDataSource[]

  @@index([courseworkId])
}

/// 資料の対象者×評価項目の点数（加減点・コメント含む）
model CourseworkScore {
  id                  String   @id @default(uuid())
  courseworkItemId    String
  courseworkStudentId String
  score               Decimal?
  letterValue         String? // 文字モード時の評価記号（"A"/"B"/"C" 等）
  adjustment          Decimal? @default(0) // 加点・減点（期限超過等）
  adjustmentReason    String? // 加減点の理由
  comment             String? // 成績通知書に表示するコメント
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  item              CourseworkItem    @relation(fields: [courseworkItemId], references: [id], onDelete: Cascade)
  courseworkStudent CourseworkStudent @relation(fields: [courseworkStudentId], references: [id], onDelete: Cascade)

  @@unique([courseworkItemId, courseworkStudentId])
  @@index([courseworkItemId])
  @@index([courseworkStudentId])
}

/// 文字評価→点数の変換表（評価項目単位。例: A=100, B=80, C=60）
model CourseworkLetterScale {
  id               String   @id @default(uuid())
  courseworkItemId String
  label            String
  score            Decimal
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  item CourseworkItem @relation(fields: [courseworkItemId], references: [id], onDelete: Cascade)

  @@unique([courseworkItemId, label])
  @@index([courseworkItemId])
}

// =============================================================================
// 解答用紙ビルダー（Answer Sheet Builder）
// =============================================================================

/// 解答用紙定義（トップレベル + GlobalSettings インライン）
model AsbDefinition {
  id         String @id @default(uuid())
  name       String @default("新しい解答用紙")
  renderMode String @default("answer-sheet")

  // LabelPresets
  labelPresetMajor  String?
  labelPresetSub    String?
  labelPresetBranch String?

  // GlobalSettings (フラット化)
  paperSize                            String  @default("A4")
  orientation                          String  @default("portrait")
  verticalLayout                       Boolean @default(false)
  baseRowHeight                        Float   @default(12)
  numberDisplayMode                    String  @default("multirow")
  marginTop                            Float   @default(15)
  marginBottom                         Float   @default(15)
  marginLeft                           Float   @default(10)
  marginRight                          Float   @default(10)
  colWidthMajorNumber                  Float   @default(10)
  colWidthSubNumber                    Float   @default(10)
  colWidthBranchNumber                 Float   @default(10)
  majorQuestionSpacing                 Float   @default(5)
  headerHeight                         Float   @default(0)
  // BorderConfig (7 styles + 7 widths)
  borderOuterBorder                    String  @default("solid")
  borderMajorDivider                   String  @default("solid")
  borderSubDivider                     String  @default("solid")
  borderBranchDivider                  String  @default("dashed")
  borderMajorNumberDivider             String  @default("solid")
  borderSubNumberDivider               String  @default("solid")
  borderBranchNumberDivider            String  @default("solid")
  borderOuterBorderWidth               Float?  @default(0.7)
  borderMajorDividerWidth              Float?  @default(0.5)
  borderSubDividerWidth                Float?  @default(0.4)
  borderBranchDividerWidth             Float?  @default(0.3)
  borderMajorNumberDividerWidth        Float?  @default(0.4)
  borderSubNumberDividerWidth          Float?  @default(0.4)
  borderBranchNumberDividerWidth       Float?  @default(0.3)
  // 原稿用紙マス目罫線（字間=行方向は破線、行間は実線が既定。色は常に黒）
  borderManuscriptCharDivider          String  @default("dashed")
  borderManuscriptLineDivider          String  @default("solid")
  borderManuscriptCharDividerWidth     Float?  @default(0.2)
  borderManuscriptLineDividerWidth     Float?  @default(0.2)
  // 破線/点線のダッシュ長・間隔（線幅に対する倍率。未指定=既定 dash3/gap2）
  borderOuterBorderDashRatio           Float?
  borderOuterBorderGapRatio            Float?
  borderMajorDividerDashRatio          Float?
  borderMajorDividerGapRatio           Float?
  borderSubDividerDashRatio            Float?
  borderSubDividerGapRatio             Float?
  borderBranchDividerDashRatio         Float?
  borderBranchDividerGapRatio          Float?
  borderMajorNumberDividerDashRatio    Float?
  borderMajorNumberDividerGapRatio     Float?
  borderSubNumberDividerDashRatio      Float?
  borderSubNumberDividerGapRatio       Float?
  borderBranchNumberDividerDashRatio   Float?
  borderBranchNumberDividerGapRatio    Float?
  borderManuscriptCharDividerDashRatio Float?
  borderManuscriptCharDividerGapRatio  Float?
  borderManuscriptLineDividerDashRatio Float?
  borderManuscriptLineDividerGapRatio  Float?
  // OMRMarkers
  omrMarkersEnabled                    Boolean @default(false)
  omrMarkersSizeMm                     Float   @default(5)
  omrMarkersOffsetMm                   Float   @default(3)
  // Fonts
  fontFamily                           String  @default("Noto Sans JP")
  fontDefaultSize                      Float   @default(6)
  fontMajorNumberSize                  Float   @default(6)
  fontSubNumberSize                    Float   @default(6)
  fontBranchNumberSize                 Float   @default(5)
  // MultiColumn
  multiColumnEnabled                   Boolean @default(false)
  multiColumnCount                     Int     @default(2)
  multiColumnGapMm                     Float   @default(5)
  multiColumnDividerLine               String?
  multiColumnDividerLineWidth          Float   @default(0.3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  majorQuestions AsbMajorQuestion[]
  headerFields   AsbHeaderField[]
  tags           AsbDefinitionTag[]

  @@index([userId])
}

/// ヘッダー記入欄
model AsbHeaderField {
  id               String  @id @default(uuid())
  definitionId     String
  type             String  @default("field") // "field" | "hfill" | "label"
  label            String
  widthMm          Float   @default(30)
  heightMm         Float   @default(8)
  gridCount        Int     @default(0)
  lineStyle        String  @default("solid")
  lineWidth        Float   @default(0.4)
  order            Int     @default(0)
  fontSize         Float? // label タイプ用
  linkedRegionType String? // "TOTAL_SCORE" | "SUBTOTAL_SCORE" | "STUDENT_NAME" | "STUDENT_ID"

  /// sqlite-nas-sync は `id` と `updatedAt` を持つテーブルだけを同期対象として自動検出し、
  /// LWW の判定にも updatedAt を使う。この2列が無いと同期の対象外になる
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition AsbDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
}

/// 大問
model AsbMajorQuestion {
  id           String   @id @default(uuid())
  definitionId String
  label        String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition   AsbDefinition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  subQuestions AsbSubQuestion[]

  @@index([definitionId])
}

/// 小問
model AsbSubQuestion {
  id                      String   @id @default(uuid())
  majorQuestionId         String
  label                   String
  order                   Int      @default(0)
  heightMultiplier        Float    @default(1)
  points                  Float    @default(1)
  usesBranchPoints        Boolean?
  layoutWidth             String?
  nextPlacement           String?
  goUp                    Int?
  // ManuscriptPaper (1:1 inline)
  manuscriptEnabled       Boolean  @default(false)
  manuscriptColumns       Int      @default(20)
  manuscriptRows          Int      @default(10)
  manuscriptCellSizeMm    Float    @default(8)
  // 文字位置マーカー（数字ガイド＋区切り罫線の統合）は「id を持つオブジェクトの配列」のため
  // JSON 直列化をやめ AsbCharGuide テーブルへ分離（issue #913）。
  // 以下 guide 設定は 1:1 のスカラー値（配列でなく JSON でもない）ためインライン継続。
  manuscriptGuideFontSize Float?
  manuscriptGuidePosition String?
  manuscriptGuidePadding  Float?
  // BorderStyles (per-side)
  borderStyleTop          String?
  borderStyleBottom       String?
  borderStyleLeft         String?
  borderStyleRight        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  majorQuestion   AsbMajorQuestion    @relation(fields: [majorQuestionId], references: [id], onDelete: Cascade)
  branchQuestions AsbBranchQuestion[]
  textElements    AsbTextElement[]
  imageElements   AsbImageElement[]
  omrConfig       AsbOmrConfig?
  charGuides      AsbCharGuide[]

  @@index([majorQuestionId])
}

/// 枝問
model AsbBranchQuestion {
  id                String  @id @default(uuid())
  subQuestionId     String
  label             String
  order             Int     @default(0)
  heightMultiplier  Float   @default(1)
  points            Float   @default(1)
  layoutWidth       String?
  nextPlacement     String?
  goUp              Int?
  borderStyleTop    String?
  borderStyleBottom String?
  borderStyleLeft   String?
  borderStyleRight  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subQuestion   AsbSubQuestion    @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  textElements  AsbTextElement[]
  imageElements AsbImageElement[]
  omrConfig     AsbOmrConfig?

  @@index([subQuestionId])
}

/// セル内テキスト要素（小問 or 枝問に紐付く dual FK）
model AsbTextElement {
  id               String  @id @default(uuid())
  subQuestionId    String?
  branchQuestionId String?
  text             String
  fontSize         Float
  horizontalAlign  String  @default("left")
  verticalAlign    String  @default("top")
  order            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subQuestion    AsbSubQuestion?    @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  branchQuestion AsbBranchQuestion? @relation(fields: [branchQuestionId], references: [id], onDelete: Cascade)

  @@index([subQuestionId])
  @@index([branchQuestionId])
}

/// セル内画像要素（小問 or 枝問に紐付く dual FK）
model AsbImageElement {
  id               String  @id @default(uuid())
  subQuestionId    String?
  branchQuestionId String?
  imagePath        String
  originalName     String
  objectFit        String  @default("contain")
  horizontalAlign  String  @default("center")
  verticalAlign    String  @default("middle")
  opacity          Float   @default(1)
  visibility       String  @default("both") // "both" | "answer-sheet-only" | "model-answer-only"
  order            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subQuestion    AsbSubQuestion?    @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  branchQuestion AsbBranchQuestion? @relation(fields: [branchQuestionId], references: [id], onDelete: Cascade)

  @@index([subQuestionId])
  @@index([branchQuestionId])
}

/// OMR設定（小問 or 枝問に紐付く dual FK）
model AsbOmrConfig {
  id               String  @id @default(uuid())
  subQuestionId    String? @unique
  branchQuestionId String? @unique
  type             String // "choice"（旧 "handwritten-digit" は #1103 で廃止）
  numChoices       Int?
  choiceLayout     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subQuestion    AsbSubQuestion?      @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)
  branchQuestion AsbBranchQuestion?   @relation(fields: [branchQuestionId], references: [id], onDelete: Cascade)
  choiceOptions  AsbOmrChoiceOption[]

  @@index([subQuestionId])
  @@index([branchQuestionId])
}

/// OMR選択肢オプション
model AsbOmrChoiceOption {
  id          String  @id @default(uuid())
  omrConfigId String
  choiceIndex Int
  label       String
  isCorrect   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  omrConfig AsbOmrConfig @relation(fields: [omrConfigId], references: [id], onDelete: Cascade)

  @@unique([omrConfigId, choiceIndex])
  @@index([omrConfigId])
}

/// 原稿用紙の文字位置マーカー（数字ガイド＋区切り罫線の統合）。
/// AsbSubQuestion.manuscriptCharGuides の JSON 直列化を廃し独立テーブル化（issue #913）。
/// order は表示順。atChar 重複は UI で禁止するが DB 制約は課さない（id で追従）。
model AsbCharGuide {
  id                String   @id @default(uuid())
  subQuestionId     String
  order             Int      @default(0)
  atChar            Int
  label             String
  boundary          String?
  boundaryWidth     Float?
  boundaryDashRatio Float?
  boundaryGapRatio  Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subQuestion AsbSubQuestion @relation(fields: [subQuestionId], references: [id], onDelete: Cascade)

  @@index([subQuestionId])
}
