{
  "private": true,
  "main": "main/electron-src/index.js",
  "productName": "一括採点",
  "version": "0.0.0",
  "scripts": {
    "clean": "rimraf dist main .next out",
    "dev": "node scripts/dev.js",
    "dev-concurrent": "npm run build-electron && concurrently \"next dev\" \"wait-on http://localhost:3000 --timeout 60000 && sleep 3 && npx electron ./main/\"",
    "build-renderer": "next build",
    "build-electron": "tsc -p electron-src",
    "build": "npm run build-renderer && npm run build-electron",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc -p ./electron-src/tsconfig.json",
    "type-check": "tsc --noEmit && tsc -p ./electron-src/tsconfig.json",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "windows-build-fix": "node scripts/windows-build-fix.js",
    "force-cleanup": "node scripts/force-cleanup.js",
    "find-lock": "node scripts/find-lock.js",
    "windows-build": "npm run windows-build-fix && npm run build && npm run make",
    "windows-build-force": "npm run force-cleanup && npm run build && npm run make"
  },
