    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-react": "^7.33.2",
    "postcss": "^8.4.38",
