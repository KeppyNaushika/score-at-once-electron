{
  "name": "score-at-once",
  "description": "完全無料・インストール不要・オフライン完結の採点支援ソフト",
  "author": "KeppyNaushika",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "main/electron-src/index.js",
  "productName": "一括採点",
  "version": "0.16.1-alpha.0",
  "scripts": {
    "predev": "node scripts/ensure-sqlite-abi.js electron",
    "dev": "node scripts/dev.js",
    "verify:assets": "node scripts/test-offline-build.js --verify-only",
    "prebuild": "npm run verify:assets",
    "build": "prisma generate && next build && node scripts/buildMain.js && node scripts/buildPreload.js",
    "dist": "npm run build && electron-forge package --platform=darwin",
    "dist:win": "npm run build && electron-forge package --platform=win32",
    "dist:linux": "npm run build && electron-forge package --platform=linux",
    "dist:all": "npm run build && electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin",
    "make:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "make:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "make:win": "electron-forge make --platform=win32",
    "make:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "make:linux": "electron-forge make --platform=linux",
    "make:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "clean": "rimraf dist main .next out",
    "lint": "eslint . --max-warnings 43 --cache --cache-strategy content --cache-location .eslintcache && node scripts/canonicalizeTailwindClasses.mjs --check && prettier --check . --cache --cache-strategy content --cache-location .prettiercache",
    "lint:fix": "eslint . --fix --max-warnings 43 --cache --cache-strategy content --cache-location .eslintcache && node scripts/canonicalizeTailwindClasses.mjs && prettier --write . --cache --cache-strategy content --cache-location .prettiercache",
    "format": "node scripts/canonicalizeTailwindClasses.mjs && prettier --write . --cache --cache-strategy content --cache-location .prettiercache",
    "typecheck": "tsc --noEmit && tsc -p ./electron-src/tsconfig.json",
    "check-all": "npm run typecheck && npm run lint",
    "check:hooks": "tsx scripts/findUnusedHookReturns.ts",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/version-release.js patch",
    "release:minor": "node scripts/version-release.js minor",
    "release:major": "node scripts/version-release.js major",
    "prerelease:patch": "node scripts/prerelease.js patch",
    "prerelease:minor": "node scripts/prerelease.js minor",
    "prerelease:major": "node scripts/prerelease.js major",
    "prerelease:alpha": "node scripts/prerelease-advanced.js patch alpha",
    "prerelease:beta": "node scripts/prerelease-advanced.js patch beta",
    "prerelease:rc": "node scripts/prerelease-advanced.js patch rc",
    "github:release:patch": "node scripts/github-release.js patch",
    "github:release:minor": "node scripts/github-release.js minor",
    "github:release:major": "node scripts/github-release.js major",
    "github:prerelease:alpha": "node scripts/github-release.js patch alpha",
    "github:prerelease:beta": "node scripts/github-release.js patch beta",
    "github:prerelease:rc": "node scripts/github-release.js patch rc",
    "postinstall": "prisma generate && node scripts/ensure-sqlite-abi.js electron && node scripts/setup-mathjax-fonts.js",
    "setup-assets": "node scripts/setup-mathjax-fonts.js",
    "screenshot:setup": "npx tsx __tests__/screenshots/setup-data.ts",
    "screenshot:test": "npx playwright test --config=__tests__/playwright.screenshot.config.ts",
    "screenshot": "npm run screenshot:setup && npm run screenshot:test",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate dev && npm run db:seed",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "test:e2e": "playwright test --config=__tests__/playwrightElectron.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "expr-eval": "^2.0.2",
    "file-selector": "^4.0.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.1.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "sqlite-nas-sync": "^0.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.0.1",
    "mathjax": "^4.1.3",
    "node-abi": "^4.33.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0"
  }
}
