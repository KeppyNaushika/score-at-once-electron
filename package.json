{
  "name": "score-at-once",
  "description": "完全無料・インストール不要・オフライン完結の採点支援ソフト",
  "author": "KeppyNaushika",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "main/electron-src/index.js",
  "productName": "一括採点",
  "version": "0.11.2-alpha.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "prisma generate && next build && node scripts/buildMain.js && node scripts/buildPreload.js",
    "dist": "npm run build && electron-forge package --platform=darwin",
    "dist:win": "npm run build && electron-forge package --platform=win32",
    "dist:linux": "npm run build && electron-forge package --platform=linux",
    "dist:all": "npm run build && electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin",
    "make:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "make:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "make:win": "electron-forge make --platform=win32",
    "make:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "make:linux": "electron-forge make --platform=linux",
    "make:linux:x64": "electron-forge make --platform=linux --arch=x64",
    "clean": "rimraf dist main .next out",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p ./electron-src/tsconfig.json",
    "check-all": "npm run typecheck && npm run lint",
    "check:hooks": "npx ts-node --transpile-only scripts/findUnusedHookReturns.ts",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/version-release.js patch",
    "release:minor": "node scripts/version-release.js minor",
    "release:major": "node scripts/version-release.js major",
    "prerelease:patch": "node scripts/prerelease.js patch",
    "prerelease:minor": "node scripts/prerelease.js minor",
    "prerelease:major": "node scripts/prerelease.js major",
    "prerelease:alpha": "node scripts/prerelease-advanced.js patch alpha",
    "prerelease:beta": "node scripts/prerelease-advanced.js patch beta",
    "prerelease:rc": "node scripts/prerelease-advanced.js patch rc",
    "github:release:patch": "node scripts/github-release.js patch",
    "github:release:minor": "node scripts/github-release.js minor",
    "github:release:major": "node scripts/github-release.js major",
    "github:prerelease:alpha": "node scripts/github-release.js patch alpha",
    "github:prerelease:beta": "node scripts/github-release.js patch beta",
    "github:prerelease:rc": "node scripts/github-release.js patch rc",
    "postinstall": "prisma generate && electron-rebuild --only better-sqlite3 && node scripts/setup-mathjax-fonts.js",
    "setup-assets": "node scripts/setup-mathjax-fonts.js",
    "screenshot:setup": "npx tsx __tests__/screenshots/setup-data.ts",
    "screenshot:test": "npx playwright test --config=__tests__/playwright.screenshot.config.ts",
    "screenshot": "npm run screenshot:setup && npm run screenshot:test",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate dev && npm run db:seed",
    "db:reset": "prisma migrate reset --force && npm run db:seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "onnxruntime-node": "^1.26.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-mathjax": "^7.1.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "sqlite-nas-sync": "^0.9.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron/rebuild": "^4.0.4",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "electron": "^41.7.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^29.1.1",
    "mathjax": "^4.1.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0"
  }
}
